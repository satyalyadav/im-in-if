# Copy to .env.local for local development. Never commit real values.

# Auth: omit for Clerk in production. "local" is a development-only adapter.
AUTH_MODE=local

# Clerk (required when AUTH_MODE is not "local")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres (omit to use the embedded local database)
DATABASE_URL=

# Personal-agent provider. Missing selected-provider credentials fail visibly.
# The current demo uses OpenCode Go only. Turn Extra Usage off before making requests.
# Model is intentionally fixed to deepseek-v4.1-flash; no fallback is configured.
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_GO_API_KEY=
OPENCODE_GO_REQUEST_TIMEOUT_MS=60000

# Resend event notices. Set these only after root verifies the sender.
RESEND_API_KEY=
RESEND_FROM=
APP_BASE_URL=http://localhost:3000

# Secured global deadline and seven-day cleanup sweep.
SCHEDULER_SECRET=
SCHEDULER_URL=http://localhost:3000/api/maintenance/sweep
