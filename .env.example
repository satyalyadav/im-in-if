# Copy to .env.local for local development. Never commit real values.

# Auth: omit for Clerk in production. "local" is a development-only adapter.
AUTH_MODE=local

# Clerk (required when AUTH_MODE is not "local")
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon Postgres (omit to use the embedded local database)
DATABASE_URL=

# ASU Research Computing OpenAI-compatible gateway
ASU_BASE_URL=https://openai.rc.asu.edu/v1
ASU_API_KEY=
ASU_MODEL=qwen38-27b
# Fail a model turn after this many milliseconds instead of hanging the chat.
ASU_REQUEST_TIMEOUT_MS=60000
